# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js build & cache
/.next/
/out/
/build

# environment files & secrets
.env*
!.env.example
*.pem
*.key
*.cert

# misc system & editor files
.DS_Store
Thumbs.db
Desktop.ini
.vscode/
.idea/
*.swp
*.swo

# debug logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
*.log

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# InsForge & BaaS credentials
.insforge
.agent
.agents
.augment
.claude
.cline
.github/copilot*
.kilocode
